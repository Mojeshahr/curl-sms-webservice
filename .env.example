# کپی کنید به .env و مقادیر خودتان را بگذارید. فایل .env نباید کامیت شود.
#
# نمونه‌ها این مقادیر را از محیط می‌خوانند و خودشان این فایل را نمی‌خوانند،
# پس پیش از اجرا واردشان کنید:
#
#   set -a; . ./.env; set +a
#   ./examples/v3/account-info.sh
#
# کلید را در خط فرمان ننویسید. هر چیزی که در آرگومان‌ها بیاید در تاریخچه شل و
# در فهرست پراسس‌های سیستم دیده می‌شود.

# کلید اختصاصی حساب، از پنل کاربری پیام رسان.
# شش رقم شناسه کاربری، خط تیره، و بخش کلید که دست‌کم پانزده نویسه است.
PAYAM_RESAN_API_KEY=123456-XXXXXXXXXXXXXXX

# یکی از خطوط فعال حساب. با examples/v3/account-info.sh فهرستشان را ببینید.
PAYAM_RESAN_SENDER=30004040
